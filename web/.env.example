# ---------------------------------------------------------------------------
# AI Song Engine - web app (Vercel) environment variables
# Copy to .env.local for local dev. In production set these in
# Vercel > Project > Settings > Environment Variables.
# NEVER commit the filled-in version.
# ---------------------------------------------------------------------------

# --- Lyrics (OpenAI) -------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional overrides:
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Song (third-party Suno wrapper) ---------------------------------------
# Suno has no official public API. Sign up with a wrapper provider
# (Apiframe / MusicAPI / Crazyrouter / etc.) and fill these in.
SUNO_PROVIDER_BASE_URL=https://api.example-suno-provider.com
SUNO_PROVIDER_API_KEY=...
# Optional: override the submit/status paths + response field names if your
# provider differs from the built-in defaults (see lib/song.js header).
SUNO_SUBMIT_PATH=/api/generate
SUNO_STATUS_PATH=/api/status
SUNO_MODEL=chirp-v3-5

# --- Thumbnail (Gemini image generation) -----------------------------------
GEMINI_API_KEY=...
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# --- Video worker (Railway/Render) -----------------------------------------
WORKER_URL=https://your-worker.up.railway.app
WORKER_SECRET=change-me-to-a-long-random-string

# --- YouTube Data API v3 ----------------------------------------------------
YT_CLIENT_ID=...apps.googleusercontent.com
YT_CLIENT_SECRET=...
YT_REFRESH_TOKEN=...
# Optional: privacy status for uploads (public | unlisted | private)
YT_PRIVACY_STATUS=public

# --- Dashboard login (Google Sign-In) --------------------------------------
# Public OAuth client ID used to render the "Sign in with Google" button and
# verify logins. Use the SAME Google OAuth client you create for YouTube.
# This must be set for anyone to log in (it's needed before login, so it lives
# here rather than in the Settings page). It is public, not a secret.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# --- Vercel Cron protection -------------------------------------------------
# Vercel injects a bearer automatically for Cron; set CRON_SECRET to require
# it on manual calls too. See pages/api/cron.js.
CRON_SECRET=change-me-cron-secret

# --- Vercel KV (auto-provided when you attach a KV/Upstash store) -----------
KV_REST_API_URL=
KV_REST_API_TOKEN=
