# ---------------------------------------------------------------------------
# AI Song Engine — worker
#
# HOW TO USE ON YOUR PC:
#   1. Copy this file and rename the copy to exactly:  .env
#   2. Paste your REDIS_URL below (get it from Vercel → your project →
#      Settings → Environment Variables → REDIS_URL → click the eye icon)
#   3. Run  start-windows.bat  (Windows)  or  npm start  (Mac/Linux)
#
# The worker reads every API key from the dashboard, so REDIS_URL is the ONLY
# thing you need here.
# ---------------------------------------------------------------------------

REDIS_URL=rediss://default:PASTE_YOUR_PASSWORD@your-redis-host:6379

# Port for the local /health page (optional)
PORT=3001

# --- Optional overrides (normally set in the dashboard Settings page) -------
# OPENAI_API_KEY=
# SUNO_PROVIDER_BASE_URL=
# GEMINI_API_KEY=
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=
# YT_PLAYLIST_ID=
# PLAYLIST_TOPIC=
# SONG_LANGUAGE=Gujarati
# DRIVE_FOLDER_NAME=AI Song Engine
# DRIVE_KEEP_SONGS=4

# Force specific fonts for the video title overlay (auto-detected otherwise).
# FONT_PATH=C:/Windows/Fonts/arialbd.ttf
# FONT_PATH_INDIC=C:/Windows/Fonts/Nirmala.ttf
