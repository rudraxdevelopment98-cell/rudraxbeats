# ---------------------------------------------------------------------------
# AI Song Engine — worker (Railway / Render)
# The worker runs the WHOLE pipeline, so it only needs Redis: every API key is
# read from the same `config` the dashboard writes.
# ---------------------------------------------------------------------------

# REQUIRED — must be the SAME Redis the Vercel app uses.
# Copy it from Vercel → your project → Settings → Environment Variables → REDIS_URL
REDIS_URL=rediss://default:password@your-redis-host:6379

# Port (Railway/Render usually inject this automatically)
PORT=3001

# --- Optional overrides ----------------------------------------------------
# Everything below normally comes from the dashboard Settings page (stored in
# Redis). Set these only if you prefer env vars.
# OPENAI_API_KEY=
# SUNO_PROVIDER_BASE_URL=
# GEMINI_API_KEY=
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=
# YT_PLAYLIST_ID=
# PLAYLIST_TOPIC=
# DRIVE_FOLDER_NAME=AI Song Engine
# DRIVE_KEEP_SONGS=4

# Font used for the title overlay (the Docker image installs DejaVu).
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
