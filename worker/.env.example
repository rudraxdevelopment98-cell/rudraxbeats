# ---------------------------------------------------------------------------
# AI Song Engine - worker (Railway/Render) environment variables
# ---------------------------------------------------------------------------

# Must EXACTLY match the web app's WORKER_SECRET (shared bearer token).
WORKER_SECRET=change-me-to-a-long-random-string

# Port the service listens on (Railway/Render usually inject PORT for you).
PORT=3001

# --- Storage: pick ONE path -------------------------------------------------
# Option A (recommended): Vercel Blob. Create a Blob store in Vercel and paste
# its read/write token here. Rendered videos upload here and get a public URL.
BLOB_READ_WRITE_TOKEN=

# Option B (fallback): serve the mp4 from this worker itself. Set this to the
# worker's OWN public URL (e.g. https://your-worker.up.railway.app). Only used
# when BLOB_READ_WRITE_TOKEN is empty.
PUBLIC_BASE_URL=

# Optional: override the font used for the title overlay.
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
